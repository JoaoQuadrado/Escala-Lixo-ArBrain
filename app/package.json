{
  "name": "escala-lixo",
  "private": true,
  "version": "1.0.0",
  "description": "Gerenciamento de escala de limpeza — desktop app",
  "main": "electron/main.cjs",
  "author": "João Quadrado",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev:web": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n web,electron -c blue,magenta \"npm run dev:web\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:full": "concurrently -k -n api,web,electron -c magenta,blue,magenta \"npm run api\" \"npm run dev:web\" \"wait-on http://127.0.0.1:5000/api/health http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "postinstall": "node node_modules/electron/install.js",
    "icons:generate": "node scripts/generate-icons.mjs",
    "electron:build": "powershell -ExecutionPolicy Bypass -File ../scripts/build-installer.ps1",
    "electron:build:quick": "npm run build && electron-builder --win",
    "electron:preview": "npm run build && cross-env NODE_ENV=production electron .",
    "api": "cross-env ASPNETCORE_ENVIRONMENT=Development dotnet run --project ../EscalaLixo.Api/EscalaLixo.Api.csproj --no-launch-profile",
    "dev:full": "concurrently -k -n api,web -c magenta,blue \"npm run api\" \"npm run dev:web\""
  },
  "build": {
    "appId": "com.escala.lixo",
    "productName": "Escala Lixo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "api-bundle",
        "to": "api",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Escala Lixo"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
